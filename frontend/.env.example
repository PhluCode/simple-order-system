# Where each Spring Boot service is listening. The Vite dev server proxies
# /api/* to these, so the browser never makes a cross-origin request and you
# do not need CORS configured on the services during development.
#
# Copy to `.env` and edit if you moved a port.

VITE_PRODUCT_SERVICE=http://localhost:8100
VITE_ORDER_SERVICE=http://localhost:8200
VITE_NOTIFICATION_SERVICE=http://localhost:8300
VITE_USER_SERVICE=http://localhost:8400

# Set to "true" to skip the network entirely and run on the bundled sample
# menu. Useful for working on the interface with the backend switched off.
VITE_USE_MOCK=false
